<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Start screen from Android 12: the app icon (amber 1× tag) on paper, as the app itself is light -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/brand_paper</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/brand_amber</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
